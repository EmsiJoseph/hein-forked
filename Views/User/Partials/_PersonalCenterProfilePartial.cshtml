@* @model Hein.Models.PersonalCenter.PersonalCenterProfileViewModel *@
@model dynamic
@{
    ViewData["Title"] = "Profile Center";
    var profileInformationHeaderStyle = "fw-bold fs-5";
    var labelStyle = "text-secondary small";
    var valueStyle = "fw-medium";
    var sectionStyle = "card border-0 shadow-sm p-4";
 
    // Provide default values if model is null
    var firstName = Model?.FirstName ?? "Guest";
    var lastName = Model?.LastName ?? "";
    var gender = Model?.Gender ?? "Prefer not to say";
    var dob = Model?.Dob;
    var email = Model?.Email ?? "No email provided";
    var isEmailConfirmed = Model.IsEmailConfirmed;
}

<style>
    .info-group {
        transition: all 0.3s ease;
        padding: 8px;
        border-radius: 4px;
    }

    .info-group:hover {
        background-color: #f8f9fa;
    }

    .section-title {
        position: relative;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 2px;
        background-color: #000;
    }

    .preference-box {
        position: relative;
        border: 1px solid #dee2e6;
        padding: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .preference-box:hover {
        border-color: #212529;
    }

    .preference-box.active {
        background-color: #212529;
        color: white;
        border-color: #212529;
    }

    .preference-box .check-icon {
        position: absolute;
        top: 8px;
        right: 8px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .preference-box.active .check-icon {
        opacity: 1;
    }

    .preference-box input[type="checkbox"] {
        position: absolute;
        opacity: 0;
    }
</style>

<div class="d-flex flex-column gap-4">
    <div class="d-flex flex-column gap-4">
        @* Profile Header *@
        <div class="@sectionStyle">
            <div class="d-flex align-items-center gap-4">
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center"
                     style="width: 100px; height: 100px;">
                    <i class="bi bi-person text-white" style="font-size: 2.5rem;"></i>
                </div>
                <div class="d-flex flex-column gap-2">
                    <h4 class="mb-1">@firstName @lastName</h4>
                    <div class="d-flex gap-3 align-items-center">
                        <p class="text-secondary mb-2">@email</p>
                        @if (@isEmailConfirmed)
                        {
                            <div class="badge bg-success">
                                <i class="bi bi-exclamation-circle"></i>
                                <span class="">Verified</span>
                            </div>
                        }
                        else
                        {
                            <div class="badge bg-danger gap-1">
                                <i class="bi bi-exclamation-circle"></i>
                                <span>Not Verified</span>
                            </div>
                        }
                    </div>
                    <button class="btn btn-outline-dark btn-sm align-self-start">
                        <i class="bi bi-pencil me-2"></i>Edit Profile
                    </button>
                </div>
            </div>
        </div>

        @* Basic Information *@
        <div class="@sectionStyle">
            <h5 class="section-title">Basic Information</h5>
            <div class="d-flex flex-column gap-3">
                <div class="row">
                    <div class="col-6">
                        <div class="info-group">
                            <div class="@labelStyle">First Name</div>
                            <div class="@valueStyle">@firstName</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-group">
                            <div class="@labelStyle">Last Name</div>
                            <div class="@valueStyle">@lastName</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="info-group">
                            <div class="@labelStyle">Date of Birth</div>
                            <div class="@valueStyle">@dob</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-group">
                            <div class="@labelStyle">Gender</div>
                            <div class="@valueStyle">@gender</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* Preference *@
    <div class="container p-4">
        <form id="preferenceForm" asp-controller="User" asp-action="UpdatePreference" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-3 align-items-start mb-4">
                <h5 class="section-title mb-0">Preference</h5>
                <span class="text-black-50">Category and style, etc.</span>
                <span class="fw-normal" style="color: orangered;">+10 HEIN POINTS</span>
            </div>
            <div class="d-flex flex-column gap-5">
                <div class="column">
                    <div class="w-100">
                        <h6 class="mb-3">Which are your favorite categories?</h6>
                    </div>
                    <div class="col-9">
                        <div class="row g-2">
                            @foreach (var preference in new[] { "Women", "Men", "PlusSize", "Kids", "Home", "PetSupplies", "Accessories", "Beauty" })
                            {
                                var isChecked = Model?.StylePreference?.Contains(preference) == true;
                                <div class="col-3">
                                    <label class="preference-box w-100 m-0 @(isChecked ? "active" : "")"
                                           for="category-@(preference.ToLower())">
                                        <i class="bi bi-check-lg check-icon"></i>
                                        <input type="checkbox" value="@preference"
                                               id="category-@(preference.ToLower())"
                                               name="StylePreference"
                                               @(isChecked ? "checked" : "")/>
                                        <span class="small">@preference</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="column">
                    <div class="w-100">
                        <h6 class="mb-3">Who do you usually shop for?</h6>
                    </div>
                    <div class="col-9">
                        <div class="row g-2">
                            @foreach (var preference in new[] { "Myself", "Partner", "Children", "Parents", "Friends", "Family", "Gifts", "Business" })
                            {
                                var isChecked = Model?.ShoppingPreference?.Contains(preference) == true;
                                <div class="col-3">
                                    <label class="preference-box w-100 m-0 @(isChecked ? "active" : "")"
                                           for="shopping-@(preference.ToLower())">
                                        <i class="bi bi-check-lg check-icon"></i>
                                        <input type="checkbox" value="@preference"
                                               id="shopping-@(preference.ToLower())"
                                               name="ShoppingPreference"
                                               @(isChecked ? "checked" : "")/>
                                        <span class="small">@preference</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="column">
                    <div class="w-100">
                        <h6 class="mb-3">What's your fashion style?</h6>
                    </div>
                    <div class="col-9">
                        <div class="row g-2">
                            @foreach (var preference in new[] { "Casual", "Formal", "Streetwear", "Vintage", "Minimalist", "Bohemian", "Athletic", "Business" })
                            {
                                var isChecked = Model?.FashionStylePreference?.Contains(preference) == true;
                                <div class="col-3">
                                    <label class="preference-box w-100 m-0 @(isChecked ? "active" : "")"
                                           for="style-@(preference.ToLower())">
                                        <i class="bi bi-check-lg check-icon"></i>
                                        <input type="checkbox" value="@preference"
                                               id="style-@(preference.ToLower())"
                                               name="FashionStylePreference"
                                               @(isChecked ? "checked" : "")/>
                                        <span class="small">@preference</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-start mt-5">
                <button type="submit" aria-disabled="true" disabled id="savePreferences" class="btn btn-dark gap-2">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span class="button-text">Save Preferences</span>
                </button>
            </div>
        </form>
    </div>
</div>