@using Hein.Data.Models
@using Hein.Helpers
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@functions {
    private async Task<User> GetUserAsync() => await UserManager.GetUserAsync(User);
}

@{
    var user = await GetUserAsync();
}


<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Hein</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/styleguide.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Hein.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="d-flex flex-column h-100">
<header class="border-bottom">
    <nav class="navbar navbar-expand-sm navbar-light bg-white ms-4 me-4 p-0">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/" class="text-decoration-none">
                <h1 class="navbar-brand">HEIN</h1>
            </a>
            @* Search Bar *@
            <div style="width: 35rem; position: relative;">
                <input type="search" class="form-control "
                       style="padding-right: 10rem;  border: 1px solid var(--defaultblack); border-radius: 0;"
                       placeholder="Search">
                <div class="d-flex align-items-center justify-content-center bg-dark text-white"
                     style="position: absolute; right: 0; top: 0; height: 100%; width: 40px; border-left: 1px solid var(--defaultblack);">
                    <i class="bi bi-search"></i>
                </div>
            </div>
            @** User Navigation **@
            <div class="d-flex flex-wrap gap-4 align-items-center">

                <div class="icon-with-menu left-align">
                    <a href="#" class="text-decoration-none text-dark">
                        <i class="bi bi-person"
                           style="font-size: 1.8rem;"></i></a>
                    <div class="menu mw-100">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <a href="@Url.Action("Index", "User")"
                               class="fw-bold text-dark text-truncate d-inline-block w-100 mw-100"> @(user?.FullName ?? user?.Email ?? "User")</a>
                        }
                        else
                        {
                            <a class="fw-bold text-dark" href="/auth">Sign In/Register</a>
                        }
                        <div class="dropdown-divider"></div>
                        <a href="#"><i class="bi bi-person-circle"></i> My Profile</a>
                        <a href="#"><i class="bi bi-box2"></i> My Orders</a>
                        <div class="dropdown-divider"></div>
                        <a href="#"><i class="bi bi-gear"></i> Settings</a>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <a href="#" class="signout-btn" data-bs-toggle="modal" data-bs-target="#signOutModal">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </a>
                        }

                    </div>
                </div>

                <div class="icon-with-menu middle-align">
                    <a href="#" class="text-decoration-none text-dark"><i class="bi bi-cart fs-4"></i></a>
                    <div class="menu">
                        <a href="#"><i class="bi bi-cart3"></i> View Cart</a>
                        <a href="#"><i class="bi bi-credit-card"></i> Checkout</a>
                        <div class="dropdown-divider"></div>
                        <a href="#"><i class="bi bi-clock-history"></i> Order History</a>
                    </div>
                </div>

                <div class="icon-with-menu middle-align">
                    <a href="#" class="text-decoration-none text-dark"><i class="bi bi-heart fs-4"></i></a>
                    <div class="menu">
                        <a href="#"><i class="bi bi-heart"></i> Wishlist</a>
                        <a href="#"><i class="bi bi-bookmark"></i> Saved Items</a>
                    </div>
                </div>

                <div class="icon-with-menu right-align">
                    <a href="#" class="text-decoration-none text-dark"><i class="bi bi-question-circle fs-4"></i></a>
                    <div class="menu">
                        <a href="#"><i class="bi bi-question-circle"></i> Help Center</a>
                        <a href="#"><i class="bi bi-chat-dots"></i> Contact Us</a>
                        <div class="dropdown-divider"></div>
                        <a href="#"><i class="bi bi-book"></i> FAQs</a>
                        <a href="#"><i class="bi bi-info-circle"></i> About Us</a>
                    </div>
                </div>

                <div class="icon-with-menu right-align">
                    <a href="#" class="text-decoration-none text-dark"><i class="bi bi-globe fs-4"></i></a>
                    <div class="menu">
                        <a href="#"><i class="bi bi-translate"></i> Language</a>
                        <a href="#"><i class="bi bi-geo-alt"></i> Region</a>
                        <div class="dropdown-divider"></div>
                        <a href="#"><i class="bi bi-currency-exchange"></i> Currency</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <nav class="navbar navbar-expand-lg p-0 ms-5 me-5">
        <div class="container-fluid p-0">
            <div class="d-flex align-items-center w-100">
                <!-- Categories Dropdown -->
                <div class="d-flex align-items-center pe-3 h-100">
                    <a class="nav-categories-btn text-decoration-none d-flex align-items-center gap-2"
                       data-bs-toggle="dropdown">
                        Categories
                        <i class="bi bi-chevron-down"></i>
                    </a>
                </div>

                <!-- Navigation Items -->
                <div class="flex-grow-1 position-relative overflow-hidden">
                    <div class="nav-items-container">
                        <div class="nav-items d-flex">
                            <a class="nav-link" href="#">New In</a>
                            <a class="nav-link" href="#">Sale</a>
                            <a class="nav-link" href="#">Women Clothing</a>
                            <a class="nav-link" href="#">Beachwear</a>
                            <a class="nav-link" href="#">Kids</a>
                            <a class="nav-link" href="#">Curve</a>
                            <a class="nav-link" href="#">Men Clothing</a>
                            <a class="nav-link" href="#">Shoes</a>
                            <a class="nav-link" href="#">Jewelry &amp; Accessories</a>
                            <a class="nav-link" href="#">Underwear &amp; Sleepwear </a>
                            <a class="nav-link" href="#">Baby &amp; Maternity</a>
                            <a class="nav-link" href="#">Bags &amp; Luggage</a>
                            <a class="nav-link" href="#">Beauty &amp; Health</a>
                            <a class="nav-link" href="#">Electronics</a>
                            <a class="nav-link" href="#">Sports &amp; Outdoors</a>
                            <a class="nav-link" href="#">Home Textiles</a>
                            <a class="nav-link" href="#">Tools &amp; Home Improvement</a>
                            <a class="nav-link" href="#">Toys &amp; Games</a>
                            <a class="nav-link" href="#">Pet Supplies</a>
                            <a class="nav-link" href="#">Appliances</a>
                            <a class="nav-link" href="#">Office &amp; School Supplies</a>
                            <a class="nav-link" href="#">Automotive</a>
                        </div>
                    </div>
                </div>

                <!-- Navigation Arrows -->
                <div class="d-flex align-items-center">
                    <button class="btn nav-arrow-btn" id="scrollLeft" disabled>
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="btn nav-arrow-btn" id="scrollRight">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>
</header>
<main role="main" class="flex-shrink-0 min-vh-100">

    @* Sonner messages *@
    @if (TempData["SuccessMessage"] != null)
    {
        <input type="hidden" id="tempDataSuccess" value="@TempData["SuccessMessage"]"/>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <input type="hidden" id="tempDataError" value="@TempData["ErrorMessage"]"/>
    }
    <div class="container">
        @RenderBody()
    </div>
</main>

<partial name="Partials/_FooterPartial"/>
<partial name="Partials/_SignOutModalPartial"/>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/sonner.js"></script>
<script src="@Url.Content("~/../../Views/Shared/_Layout.cshtml.js")"></script>
@await RenderSectionAsync("Scripts", required: false)

<partial name="Partials/_SonnerPartial"/>


</body>
</html>

