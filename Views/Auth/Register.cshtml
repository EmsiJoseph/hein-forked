@model Hein.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="container d-flex flex-column align-items-center mt-5 pb-5 gap-4">
    <div class="d-flex flex-column align-items-center gap-4 " style="width: 558px;">
        <a class="w-100 d-flex gap-1 text-decoration-none text-dark" href="/auth">
            <i class="bi bi-chevron-left"></i>
            Back
        </a>
        <div class="d-flex flex-column gap-4 px-5">
            <h5 class="text-center mb-2 fw-bold" style="font-family: var(--bold-h5-heading-font-family);">
                Create your HEIN account
            </h5>

            <div class="text-center">
                <span class="badge bg-success rounded-pill mb-2 fs-6">GET P150 OFF ON YOUR FIRST ORDER</span>
                <p class="small" style="font-family: var(--body-small-font-family);">
                    <span class="fw-bold">CODE:</span> WELCOMEPH
                </p>
            </div>

            <form method="post" asp-controller="Auth" asp-action="Register" class="w-100 d-flex flex-column gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FromOAuth" />
                <div class="d-flex flex-column gap-2">
                    <label asp-for="Email" class="small required">Email address</label>
                    <div class="input-group">
                        <input value="@Model.Email" aria-readonly="true" aria-label="Email address" readonly id="Email" asp-for="Email" type="text"
                               class="form-control"/>

                        <a href="/auth" class="btn btn-dark">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <label asp-for="Password" class="small required">Password</label>
                    <div class="input-group">
                        <input aria-label="Password" autofocus asp-for="Password" type="password" class="form-control"/>
                        <button class="btn btn-outline-dark toggle-password" type="button">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>

                    <div class="progress mt-2" style="height: 10px;">
                        <div id="passwordStrengthBar" class="progress-bar" role="progressbar"
                             style="width: 0%;"></div>
                    </div>
                    <small id="passwordStrengthText"></small>

                    <div class="password-requirements small form-text" id="passwordRequirements">
                        <p class="mb-2">Password must contain at least:</p>
                        <div class="row">
                            <div class="col-4">
                                <ul class="list-unstyled">
                                    <li id="lengthCheck" class="text-danger">
                                        <i class="bi bi-circle"></i> 8 characters
                                    </li>
                                    <li id="lowercaseCheck" class="text-danger">
                                        <i class="bi bi-circle"></i> 1 lowercase letter
                                    </li>
                                </ul>
                            </div>
                            <div class="col-4">
                                <ul class="list-unstyled">
                                    <li id="uppercaseCheck" class="text-danger">
                                        <i class="bi bi-circle"></i> 1 uppercase letter
                                    </li>
                                    <li id="digitCheck" class="text-danger">
                                        <i class="bi bi-circle"></i> 1 number
                                    </li>
                                </ul>
                            </div>
                            <div class="col-4">
                                <ul class="list-unstyled">
                                    <li id="specialCheck" class="text-danger">
                                        <i class="bi bi-circle"></i> 1 special character
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <label asp-for="ConfirmPassword" class="small required">Confirm password</label>
                    <div class="input-group">
                        <input aria-label="Confirm password" asp-for="ConfirmPassword" type="password" class="form-control"/>
                        <button class="btn btn-outline-dark toggle-password" type="button">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <small aria-hidden="true" hidden id="passwordMatchValidation" class="text-danger">
                        <i class="bi bi-circle"></i> Passwords do not match
                    </small>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <input asp-for="EmailSubscription" type="checkbox" class="form-check-input"/>
                    <label asp-for="EmailSubscription" class="form-check-label small">
                        I want to receive exclusive offers and latest news by email
                    </label>
                </div>

                <button aria-disabled="true" disabled class="btn btn-dark w-100 fw-bold" type="submit">REGISTER</button>
            </form>

            <p class="terms-notice text-center small">
                <span class="text-secondary">By registering to HEIN, you agree to our </span>
                <a href="#" class="text-primary text-decoration-none">Privacy & Cookie Policy</a>
                <span class="text-secondary"> and </span>
                <a href="#" class="text-primary text-decoration-none">Terms & Conditions</a>
                <span class="text-secondary">.</span>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Views/Auth/Register.cshtml.js")"></script>
    <script src="~/js/togglePassword.js"></script>
}
